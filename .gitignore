# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Sayaw ---

# Nested build output (the generated rule above is root-anchored only).
build/

# CocoaPods — the Podfile and Podfile.lock are committed, the pods are not.
ios/Pods/
macos/Pods/
ios/.symlinks/
macos/.symlinks/

# Secrets: Plex tokens and TIDAL client credentials never enter the repo.
# Runtime tokens live in flutter_secure_storage, not here.
.env
.env.*
!.env.example

# Golden diff output, written on failure. Look at it, never commit it.
test/**/failures/
